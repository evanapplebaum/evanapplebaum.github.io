---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const p = project.data;
const href = p.detail ? `/projects/${project.id}/` : undefined;
---

<article class:list={['project-card', { clickable: !!href }]}>
  {href && <a class="card-overlay" href={href} aria-label={`${p.title} details`}></a>}
  <div class="project-img">
    <Image
      src={p.cover.src}
      alt={p.cover.alt}
      widths={[480, 800, 1200]}
      sizes="(max-width: 768px) 100vw, 400px"
      style={p.cover.position ? `object-position: ${p.cover.position}` : undefined}
    />
  </div>
  <div class="project-content">
    <div class="project-tags">
      {p.tags.map((t) => <span class="project-tag">{t}</span>)}
    </div>
    <h3>{p.title}{p.wip && <span class="wip"> [WIP]</span>}</h3>
    <p>{p.summary}</p>
    {(href || p.github || p.link) && (
      <div class="project-links">
        {href && <a href={href} class="project-link">More Details ↗</a>}
        {p.github && <a href={p.github} class="project-link" target="_blank" rel="noopener noreferrer">GitHub ↗</a>}
        {p.link && <a href={p.link} class="project-link" target="_blank" rel="noopener noreferrer">Link ↗</a>}
      </div>
    )}
  </div>
</article>

<style>
  .project-card {
    position: relative;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 4px;
    overflow: hidden;
    transition: border-color 0.3s, transform 0.3s;
  }

  .project-card:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
  }

  .card-overlay { position: absolute; inset: 0; z-index: 1; }

  .project-img {
    width: 100%;
    aspect-ratio: 16/9;
    background: var(--surface);
    overflow: hidden;
  }

  .project-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(30%);
    transition: filter 0.3s;
  }

  .project-card:hover .project-img img { filter: grayscale(0%) contrast(1.1); }

  .project-content { padding: 1.5rem; }

  .project-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1rem; }

  .project-tag {
    font-family: var(--mono);
    font-size: 0.6rem;
    padding: 0.2rem 0.5rem;
    background: rgba(0, 229, 255, 0.08);
    border: 1px solid rgba(0, 229, 255, 0.2);
    color: var(--accent);
    border-radius: 2px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h3 { font-size: 1.2rem; font-weight: 700; margin-bottom: 0.75rem; letter-spacing: -0.01em; }

  p {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--muted);
    line-height: 1.8;
    margin-bottom: 1.25rem;
  }

  .project-links { display: flex; gap: 1.25rem; position: relative; z-index: 2; }

  .project-link {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--accent);
    text-decoration: none;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: opacity 0.2s;
  }

  .project-link:hover { opacity: 0.7; }
</style>
