---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../site.config';
import { md } from '../lib/md';
import headshot from '../assets/headshot.jpeg';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base>
  <nav class="site-nav" slot="nav">
    <a class="nav-logo" href="/">{site.logo}</a>
    <ul class="nav-links">
      <li><a href="#about">About</a></li>
      <li><a href="#projects">Projects</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>
  </nav>

  <!-- HERO -->
  <div class="hero">
    <div class="hero-text">
      <div class="hero-tag">{site.hero.tagline}</div>
      <h1>{site.name.first}<br /><span>{site.name.last}</span></h1>
      <p class="hero-subtitle" set:html={md(site.hero.subtitle)} />
      <div class="hero-buttons">
        <a href="#projects" class="btn btn-primary">View Projects</a>
        <a href="#contact" class="btn">Get In Touch</a>
      </div>
    </div>

    <div class="hero-image">
      <Image
        src={headshot}
        alt={site.hero.photoAlt}
        widths={[480, 960]}
        sizes="(max-width: 768px) 100vw, 480px"
        loading="eager"
        style={`object-position: ${site.hero.photoPosition}`}
      />
    </div>
  </div>

  <!-- ABOUT -->
  <section id="about">
    <div class="section-label">01 — About</div>
    <h2>Who I Am</h2>
    <div class="about-grid">
      <div class="about-text">
        {site.about.paragraphs.map((p) => <p set:html={md(p)} />)}
      </div>
      <div class="skills-grid">
        {
          site.about.skills.map((s) => (
            <div class="skill-group">
              <h4>{s.group}</h4>
              <div class="skill-tags">
                {s.items.map((i) => <span class="tag">{i}</span>)}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- PROJECTS -->
  <section id="projects">
    <div class="section-label">02 — Projects</div>
    <h2>What I've Built</h2>
    <div class="projects-grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact">
    <div class="section-label">03 — Contact</div>
    <h2>{site.contact.heading}</h2>
    <p set:html={md(site.contact.text)} />
    <div class="contact-links">
      <a
        href={`https://mail.google.com/mail/?view=cm&to=${site.contact.email}`}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary">Email Me</a
      >
      <a href={site.contact.linkedin} target="_blank" rel="noopener noreferrer" class="btn">LinkedIn</a>
      <a href={site.contact.github} target="_blank" rel="noopener noreferrer" class="btn">GitHub</a>
    </div>
  </section>
</Base>

<style>
  /* HERO */
  .hero {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    padding: 6rem 4rem 4rem;
    gap: 4rem;
    position: relative;
  }

  .hero::after {
    content: '';
    position: absolute;
    top: 20%;
    right: 10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(0,229,255,0.06) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-text { animation: fadeUp 0.8s ease both; }

  .hero-tag {
    font-family: var(--mono);
    font-size: 0.9rem;
    color: var(--accent);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-tag::before {
    content: '';
    display: block;
    width: 2rem;
    height: 1px;
    background: var(--accent);
  }

  h1 {
    font-size: clamp(3rem, 6vw, 5.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
  }

  h1 span { color: var(--accent); }

  .hero-subtitle {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.8;
    max-width: 42ch;
    margin-bottom: 2.5rem;
  }

  .hero-buttons { display: flex; gap: 1rem; flex-wrap: wrap; }

  .hero-image {
    position: relative;
    animation: fadeUp 0.8s 0.2s ease both;
    width: 100%;
    max-width: 480px;
    aspect-ratio: 3/4;
    margin-left: auto;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 4px;
    display: block;
    filter: grayscale(20%) contrast(1.05);
    position: relative;
  }

  /* SECTIONS */
  section {
    padding: 6rem 4rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-label { font-size: 1rem; }

  h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    margin-bottom: 3rem;
    letter-spacing: -0.02em;
  }

  /* ABOUT */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .about-text p {
    font-family: var(--mono);
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 2;
    margin-bottom: 1.25rem;
  }

  .about-text :global(strong) { color: var(--text); }

  .skills-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }

  .skill-group h4 {
    font-family: var(--mono);
    font-size: 0.65rem;
    color: var(--accent);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .skill-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }

  .tag {
    font-family: var(--mono);
    font-size: 0.65rem;
    padding: 0.3rem 0.6rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 2px;
    color: var(--text);
    letter-spacing: 0.05em;
  }

  /* PROJECTS */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 1.5rem;
  }

  /* CONTACT */
  #contact p {
    font-family: var(--mono);
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 2;
    margin-bottom: 2.5rem;
  }

  .contact-links { display: flex; gap: 1.5rem; flex-wrap: wrap; }

  @media (max-width: 768px) {
    .hero { grid-template-columns: minmax(0, 1fr); padding: 5rem 1.5rem 3rem; gap: 2.5rem; }
    h1 { font-size: min(3rem, 9vw); }
    .hero-image { order: -1; max-width: 100%; aspect-ratio: unset; height: 400px; }
    section { padding: 4rem 1.5rem; }
    .about-grid { grid-template-columns: 1fr; gap: 2rem; }
    .projects-grid { grid-template-columns: 1fr; }
  }
</style>
