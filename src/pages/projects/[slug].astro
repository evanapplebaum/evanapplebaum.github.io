---
// Template for every project with `detail: true` in its frontmatter.
// Each section only renders if the project defines it.
import { Image, getImage } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../site.config';
import { md } from '../../lib/md';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => data.detail && !data.draft);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const p = project.data;
const { Content } = await render(project);
const hasOverview = !!project.body?.trim();
const [headA, headB] = p.heading ?? [p.title, ''];

// Large versions for the lightbox
const fullSize = await Promise.all(
  p.gallery.map((g) => getImage({ src: g.src, width: Math.min(1600, g.src.width), quality: 80 }).then((r) => r.src)),
);
---

<Base title={`${p.title} — ${site.name.first} ${site.name.last}`} description={p.summary}>
  <nav class="site-nav" slot="nav">
    <a class="nav-logo" href="/">{site.logo}</a>
    <a class="nav-back" href="/#projects">← Back to Projects</a>
  </nav>

  {
    p.gallery.length > 0 && (
      <div class="lightbox" id="lightbox" data-images={JSON.stringify(fullSize)}>
        <button class="lightbox-close" data-action="close">✕ Close</button>
        <img id="lightbox-img" src="" alt="" />
        <div class="lightbox-nav">
          <button class="lightbox-btn" data-action="prev">← Prev</button>
          <span class="lightbox-counter" id="lightbox-counter">1 / 1</span>
          <button class="lightbox-btn" data-action="next">Next →</button>
        </div>
      </div>
    )
  }

  <!-- HERO -->
  <div class="project-hero">
    <div class="breadcrumb">
      <a href="/">Home</a><span>/</span><a href="/#projects">Projects</a><span>/</span>{p.title}
    </div>

    <h1>{headA} {headB && <span>{headB}</span>}</h1>

    {
      p.meta.length > 0 && (
        <div class="project-meta">
          {p.meta.map((m) => (
            <div class="meta-item">
              <strong>{m.label}</strong>
              {m.value}
            </div>
          ))}
        </div>
      )
    }

    <div class="tag-row">
      {p.techTags.map((t) => <span class="ptag ptag-accent">{t}</span>)}
      {p.otherTags.map((t) => <span class="ptag ptag-plain">{t}</span>)}
    </div>

    {
      p.hero && (
        <div class="hero-image-wrap">
          <Image
            src={p.hero.src}
            alt={p.hero.alt}
            widths={[800, 1200, 1600]}
            sizes="(max-width: 1200px) 100vw, 1100px"
            loading="eager"
            style={p.hero.position ? `object-position: ${p.hero.position}` : undefined}
          />
        </div>
      )
    }
  </div>

  {
    p.stats.length > 0 && (
      <div class="stats-wrap">
        <div class="stats-bar" style={`--cols: ${Math.min(p.stats.length, 4)}`}>
          {p.stats.map((s) => (
            <div class="stat">
              <div class="stat-value">{s.value}</div>
              <div class="stat-label">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    )
  }

  <div class="content-wrap">
    {
      hasOverview && (
        <div class="block">
          <div class="section-label">Overview</div>
          <h2>What & Why</h2>
          <div class="prose">
            <Content />
          </div>
        </div>
      )
    }

    {
      (p.specs.length > 0 || p.feature) && (
        <div class:list={['block', { 'two-col': p.specs.length > 0 && p.feature }]}>
          {p.specs.length > 0 && (
            <div>
              <div class="section-label">Specs</div>
              <h2>Full System Specs</h2>
              <table class="spec-table">
                {p.specs.map((group) => (
                  <>
                    <tr class="spec-section-header">
                      <td colspan="2">{group.section}</td>
                    </tr>
                    {group.rows.map(([k, v]) => (
                      <tr>
                        <td>{k}</td>
                        <td>{v}</td>
                      </tr>
                    ))}
                  </>
                ))}
              </table>
            </div>
          )}
          {p.feature && (
            <div>
              <div class="section-label">{p.feature.label}</div>
              <h2>{p.feature.title}</h2>
              <div class="feature-img">
                <Image
                  src={p.feature.image.src}
                  alt={p.feature.image.alt}
                  widths={[500, 900]}
                  sizes="(max-width: 768px) 100vw, 520px"
                  style={p.feature.image.position ? `object-position: ${p.feature.image.position}` : undefined}
                />
              </div>
              <p class="caption" set:html={md(p.feature.caption)} />
            </div>
          )}
        </div>
      )
    }

    {
      p.gallery.length > 0 && (
        <div class="block">
          <div class="section-label">Gallery</div>
          <h2>Build Photos</h2>
          <div class="gallery-grid">
            {p.gallery.map((g, i) => (
              <button class="gallery-item" data-index={i} aria-label={`Open photo: ${g.alt}`}>
                <Image
                  src={g.src}
                  alt={g.alt}
                  widths={[400, 700]}
                  sizes="(max-width: 768px) 50vw, 370px"
                  style={g.position ? `object-position: ${g.position}` : undefined}
                />
              </button>
            ))}
          </div>
        </div>
      )
    }

    {
      p.challenges.length > 0 && (
        <div class="block">
          <div class="section-label">Engineering Challenges</div>
          <h2>What Was Hard</h2>
          <div class="challenge-list">
            {p.challenges.map((c) => (
              <div class="challenge-item">
                <h4>{c.title}</h4>
                <p set:html={md(c.body)} />
              </div>
            ))}
          </div>
        </div>
      )
    }

    <div class="cta">
      <p>Want to know more about this build?</p>
      <div class="cta-buttons">
        {p.github && <a href={p.github} target="_blank" rel="noopener noreferrer" class="btn">GitHub ↗</a>}
        {p.link && <a href={p.link} target="_blank" rel="noopener noreferrer" class="btn">Link ↗</a>}
        <a href="/#contact" class="btn btn-primary">Get In Touch</a>
      </div>
    </div>
  </div>

  <footer class="site-footer" slot="footer">
    <span>© {new Date().getFullYear()} {site.name.first} {site.name.last}</span>
    <a href="/">← Back to Portfolio</a>
  </footer>
</Base>

<script>
  const lightbox = document.getElementById('lightbox');
  if (lightbox) {
    const images: string[] = JSON.parse(lightbox.dataset.images ?? '[]');
    const img = document.getElementById('lightbox-img') as HTMLImageElement;
    const counter = document.getElementById('lightbox-counter')!;
    let current = 0;

    const show = (i: number) => {
      current = (i + images.length) % images.length;
      img.src = images[current];
      counter.textContent = `${current + 1} / ${images.length}`;
    };
    const open = (i: number) => {
      show(i);
      lightbox.classList.add('active');
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      lightbox.classList.remove('active');
      document.body.style.overflow = '';
    };

    document.querySelectorAll<HTMLElement>('.gallery-item').forEach((el) =>
      el.addEventListener('click', () => open(Number(el.dataset.index))),
    );

    lightbox.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const action = target.dataset.action;
      if (target === lightbox || action === 'close') close();
      else if (action === 'next') show(current + 1);
      else if (action === 'prev') show(current - 1);
    });

    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('active')) return;
      if (e.key === 'ArrowRight') show(current + 1);
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'Escape') close();
    });
  }
</script>

<style>
  /* HERO */
  .project-hero {
    padding: 8rem 4rem 4rem;
    max-width: 1200px;
    margin: 0 auto;
    animation: fadeUp 0.8s ease both;
  }

  .breadcrumb {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--muted);
    letter-spacing: 0.1em;
    margin-bottom: 1.5rem;
  }

  .breadcrumb a { color: var(--accent); text-decoration: none; }
  .breadcrumb span { margin: 0 0.5rem; }

  h1 {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    margin-bottom: 1.5rem;
  }

  h1 span { color: var(--accent); }

  .project-meta { display: flex; gap: 2rem; flex-wrap: wrap; margin-bottom: 2rem; }

  .meta-item {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--muted);
    letter-spacing: 0.08em;
  }

  .meta-item strong {
    display: block;
    color: var(--accent);
    margin-bottom: 0.2rem;
    text-transform: uppercase;
    font-size: 0.6rem;
    letter-spacing: 0.15em;
  }

  .tag-row { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 3rem; }

  .ptag {
    font-family: var(--mono);
    font-size: 0.65rem;
    padding: 0.3rem 0.7rem;
    border-radius: 2px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ptag-accent { background: rgba(0,229,255,0.08); border: 1px solid rgba(0,229,255,0.25); color: var(--accent); }
  .ptag-plain { background: var(--surface); border: 1px solid var(--border); color: var(--text); }

  .hero-image-wrap {
    width: 100%;
    aspect-ratio: 21/9;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 5rem;
  }

  .hero-image-wrap img { width: 100%; height: 100%; object-fit: cover; filter: contrast(1.05); }

  /* STATS */
  .stats-wrap { max-width: 1200px; margin: 0 auto 5rem; padding: 0 4rem; }

  .stats-bar {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    border: 1px solid var(--border);
    border-radius: 4px;
    overflow: hidden;
  }

  .stat { padding: 2rem 1.5rem; border-right: 1px solid var(--border); position: relative; }
  .stat:last-child { border-right: none; }

  .stat::before {
    content: '';
    position: absolute;
    bottom: 0; left: 0;
    height: 2px;
    width: 100%;
    background: var(--accent);
    opacity: 0;
    transition: opacity 0.3s;
  }

  .stat:hover::before { opacity: 1; }

  .stat-value {
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 800;
    color: var(--accent);
    letter-spacing: -0.02em;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .stat-label {
    font-family: var(--mono);
    font-size: 0.65rem;
    color: var(--muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* CONTENT */
  .content-wrap { max-width: 1200px; margin: 0 auto; padding: 0 4rem 6rem; }
  .block { margin-bottom: 5rem; }
  .section-label { font-size: 0.7rem; }

  h2 {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
  }

  .prose {
    font-family: var(--mono);
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 2;
    max-width: 72ch;
  }

  .prose :global(p + p) { margin-top: 1.25rem; }
  .prose :global(strong) { color: var(--text); }
  .prose :global(a) { color: var(--accent); }
  .prose :global(h2), .prose :global(h3) { color: var(--text); font-family: var(--sans); margin: 2.5rem 0 1rem; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.5rem; margin: 1rem 0; }
  .prose :global(code) { color: var(--text); background: var(--surface); padding: 0.1rem 0.35rem; border-radius: 2px; }
  .prose :global(img) { max-width: 100%; border-radius: 4px; margin: 1.5rem 0; }

  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; }

  .spec-table { width: 100%; border-collapse: collapse; font-family: var(--mono); font-size: 0.75rem; }
  .spec-table tr { border-bottom: 1px solid var(--border); }
  .spec-table tr:last-child { border-bottom: none; }
  .spec-table td { padding: 0.85rem 0.5rem; vertical-align: top; }
  .spec-table td:first-child { color: var(--muted); width: 45%; letter-spacing: 0.05em; }
  .spec-table td:last-child { color: var(--text); font-weight: 700; }

  .spec-section-header td {
    color: var(--accent) !important;
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding-top: 1.5rem !important;
    font-weight: 400 !important;
  }

  .feature-img {
    aspect-ratio: 3/4;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    overflow: hidden;
  }

  .feature-img img { width: 100%; height: 100%; object-fit: cover; }

  .caption {
    font-family: var(--mono);
    font-size: 0.65rem;
    color: var(--muted);
    margin-top: 0.75rem;
    line-height: 1.8;
  }

  /* GALLERY */
  .gallery-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }

  .gallery-item {
    aspect-ratio: 4/3;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    overflow: hidden;
    cursor: pointer;
    padding: 0;
    transition: border-color 0.3s, transform 0.3s;
  }

  .gallery-item:hover { border-color: var(--accent); transform: scale(1.02); }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(15%);
    transition: filter 0.3s;
  }

  .gallery-item:hover img { filter: grayscale(0%); }

  /* LIGHTBOX */
  .lightbox {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.95);
    z-index: 500;
    display: none;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 1.5rem;
  }

  .lightbox.active { display: flex; }
  .lightbox img { max-width: 90vw; max-height: 80vh; object-fit: contain; border-radius: 2px; }

  .lightbox-close, .lightbox-btn {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--muted);
    cursor: pointer;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: none;
    transition: all 0.2s;
  }

  .lightbox-close { position: absolute; top: 2rem; right: 2rem; border: none; }
  .lightbox-btn { border: 1px solid var(--border); padding: 0.5rem 1.25rem; border-radius: 2px; }
  .lightbox-close:hover, .lightbox-btn:hover { color: var(--accent); border-color: var(--accent); }
  .lightbox-nav { display: flex; gap: 2rem; align-items: center; }

  .lightbox-counter { font-family: var(--mono); font-size: 0.65rem; color: var(--muted); letter-spacing: 0.1em; }

  /* CHALLENGES */
  .challenge-list { display: flex; flex-direction: column; gap: 1.5rem; }

  .challenge-item {
    background: var(--card);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 0 4px 4px 0;
    padding: 1.5rem;
  }

  .challenge-item h4 {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .challenge-item p { font-family: var(--mono); font-size: 0.78rem; color: var(--muted); line-height: 1.9; }
  .challenge-item p :global(strong) { color: var(--text); }

  /* CTA */
  .cta {
    border-top: 1px solid var(--border);
    padding-top: 3rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .cta p { font-family: var(--mono); font-size: 0.7rem; color: var(--muted); }
  .cta-buttons { display: flex; gap: 1rem; flex-wrap: wrap; }
  .cta .btn { font-size: 0.7rem; padding: 0.75rem 1.5rem; }

  @media (max-width: 768px) {
    .project-hero { padding: 6rem 1.5rem 3rem; }
    h1 { font-size: min(2.5rem, 9vw); }
    .stats-wrap { padding: 0 1.5rem; }
    .content-wrap { padding: 0 1.5rem 4rem; }
    .stats-bar { grid-template-columns: repeat(2, 1fr); }
    .stat { border-bottom: 1px solid var(--border); }
    .two-col { grid-template-columns: 1fr; gap: 2rem; }
    .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
